{
  "name": "daball-tailwindcss",
  "version": "1.0.0",
  "description": "",
  "main": "tailwind.config.js",
  "scripts": {
    "dev": "npm run build:css && concurrently -k \"npm:dev:*\"",
    "dev:css": "npx @tailwindcss/cli -i ./src/tailwind/input.css -o ./assets/ui/css/tailwind.g.css --watch",
    "dev:dx": "dx serve --package site-daball-me --platform server",
    "build": "npm run build:css && dx build --release --package site-daball-me",
    "build:css": "npx @tailwindcss/cli -i ./src/tailwind/input.css -o ./assets/ui/css/tailwind.g.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "concurrently": "^8.2.2"
  }
}
